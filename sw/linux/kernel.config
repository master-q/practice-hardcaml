# Kernel configuration fragment for the Linux SoC (#21), applied on top of
# `make tinyconfig` by sw/linux/build-kernel.sh. Single core, Sv32 MMU,
# RV32IMA without C and FPU, console on a 16550 found in the device tree,
# UART interrupts through the PLIC, timer through Sstc, initramfs only.
CONFIG_ARCH_RV32I=y
CONFIG_NONPORTABLE=y
CONFIG_MMU=y
CONFIG_SMP=n
CONFIG_RISCV_ISA_C=n
CONFIG_FPU=n
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_RISCV_ISA_ZAWRS=n
CONFIG_EFI=n
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SIFIVE_PLIC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=n
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_MULTIUSER=n
CONFIG_CMDLINE="console=ttyS0 earlycon"
CONFIG_CMDLINE_FORCE=y
